<?php

class mascota{
    //propiedades
    public string $nombre;
    public string $especie;
    public int $edad;
    public int $id;

    //Constructor

    public function __construct(string $nombre, string $especie, int $edad, int $id){
        $this->nombre = $nombre;
        $this->especie = $especie;
        $this->edad = $edad;
        $this->id = $id;

    }
    public function presentarMascota(){
        return "Nombre de la mascota: ".$this->nombre;
    }

    
}

