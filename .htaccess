RewriteEngine On

# Si lo que se pide es un archivo o carpeta que existe de verdad, se entrega tal cual
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demas se manda a index.php, diciendole que pagina se pidio
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?vista=$1 [L,QSA]